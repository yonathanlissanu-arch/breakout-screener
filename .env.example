# Copy this file to .env and fill in your key(s).
# The screener uses yfinance by default (free, no key needed).
# Set one of these to use a faster/more reliable backend:

# --- Financial Modeling Prep (FMP) ---
# Free tier: ~250 calls/day.  Basic tier ~$14/mo: 300 calls/min
# Sign up: https://financialmodelingprep.com/developer/docs/
# FMP_API_KEY=your_key_here

# --- Polygon.io ---
# Free tier: 5 calls/min (full universe ~9 hrs first run, cached after).
# Starter ~$29/mo: unlimited calls/min (full universe ~3-5 min)
# Sign up: https://polygon.io/
# POLYGON_API_KEY=your_key_here
